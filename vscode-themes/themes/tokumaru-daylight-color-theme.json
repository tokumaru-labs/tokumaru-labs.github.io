{
  "$schema": "vscode://schemas/color-theme",
  "name": "Tokumaru Daylight",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#344D70",
    "focusBorder": "#3F72A7",
    "widget.border": "#BAC8D9",
    "selection.background": "#B4CDDE99",
    "activityBar.background": "#D1DDEA",
    "activityBar.foreground": "#3F72A7",
    "activityBar.inactiveForeground": "#60728B",
    "activityBar.activeBorder": "#3F72A7",
    "activityBar.border": "#BAC8D9",
    "activityBarBadge.background": "#3F72A7",
    "activityBarBadge.foreground": "#D1DDEA",
    "titleBar.activeBackground": "#D1DDEA",
    "titleBar.activeForeground": "#344D70",
    "titleBar.inactiveBackground": "#DFE7F1",
    "titleBar.inactiveForeground": "#60728B",
    "titleBar.border": "#BAC8D9",
    "commandCenter.background": "#DFE7F1",
    "commandCenter.foreground": "#344D70",
    "commandCenter.border": "#BAC8D9",
    "sideBar.background": "#DDE5EF",
    "sideBar.foreground": "#344D70",
    "sideBar.border": "#BAC8D9",
    "sideBarTitle.foreground": "#344D70",
    "sideBarSectionHeader.background": "#DFE7F1",
    "sideBarSectionHeader.foreground": "#344D70",
    "editorGroup.border": "#BAC8D9",
    "editorGroupHeader.tabsBackground": "#DFE7F1",
    "tab.activeBackground": "#E8EDF5",
    "tab.activeForeground": "#344D70",
    "tab.activeBorderTop": "#3F72A7",
    "tab.inactiveBackground": "#DDE5EF",
    "tab.inactiveForeground": "#60728B",
    "tab.border": "#BAC8D9",
    "editor.background": "#E8EDF5",
    "editor.foreground": "#344A68",
    "editorCursor.foreground": "#3F72A7",
    "editorLineNumber.foreground": "#60728B",
    "editorLineNumber.activeForeground": "#3F72A7",
    "editor.selectionBackground": "#B4CDDE88",
    "editor.inactiveSelectionBackground": "#B4CDDE99",
    "editor.selectionHighlightBackground": "#B4CDDE99",
    "editor.wordHighlightBackground": "#B4CDDE99",
    "editor.wordHighlightStrongBackground": "#B4CDDE99",
    "editor.lineHighlightBackground": "#DCE6F2",
    "editorIndentGuide.background1": "#BAC8D9",
    "editorIndentGuide.activeBackground1": "#60728B",
    "editorWhitespace.foreground": "#BAC8D9",
    "editorRuler.foreground": "#BAC8D9",
    "editorBracketMatch.background": "#B4CDDE99",
    "editorBracketMatch.border": "#3F72A7",
    "editorBracketHighlight.foreground1": "#3F72A7",
    "editorBracketHighlight.foreground2": "#8C591F",
    "editorBracketHighlight.foreground3": "#75539E",
    "editorBracketHighlight.foreground4": "#126E75",
    "editorBracketHighlight.foreground5": "#225B8B",
    "editorBracketHighlight.foreground6": "#994E32",
    "editorGutter.modifiedBackground": "#3F72A7",
    "editorGutter.addedBackground": "#24784E",
    "editorGutter.deletedBackground": "#B73441",
    "editorError.foreground": "#B73441",
    "editorWarning.foreground": "#956216",
    "editorInfo.foreground": "#3F72A7",
    "editorHoverWidget.background": "#DDE5EF",
    "editorHoverWidget.foreground": "#344D70",
    "editorHoverWidget.border": "#BAC8D9",
    "editorSuggestWidget.background": "#DDE5EF",
    "editorSuggestWidget.foreground": "#344D70",
    "editorSuggestWidget.border": "#BAC8D9",
    "editorSuggestWidget.selectedBackground": "#B4CDDE99",
    "editorWidget.background": "#DDE5EF",
    "editorWidget.foreground": "#344D70",
    "editorWidget.border": "#BAC8D9",
    "list.activeSelectionBackground": "#CFE5F1",
    "list.activeSelectionForeground": "#344D70",
    "list.inactiveSelectionBackground": "#DCE6F2",
    "list.hoverBackground": "#DCE6F2",
    "list.highlightForeground": "#3F72A7",
    "list.focusOutline": "#3F72A7",
    "input.background": "#E8EDF5",
    "input.foreground": "#344D70",
    "input.border": "#BAC8D9",
    "input.placeholderForeground": "#60728B",
    "inputOption.activeBorder": "#3F72A7",
    "dropdown.background": "#DDE5EF",
    "dropdown.foreground": "#344D70",
    "dropdown.border": "#BAC8D9",
    "button.background": "#3F72A7",
    "button.foreground": "#D1DDEA",
    "button.hoverBackground": "#225B8B",
    "button.secondaryBackground": "#DDE5EF",
    "button.secondaryForeground": "#344D70",
    "badge.background": "#CFE5F1",
    "badge.foreground": "#344D70",
    "panel.background": "#DFE7F1",
    "panel.border": "#BAC8D9",
    "panelTitle.activeBorder": "#3F72A7",
    "panelTitle.activeForeground": "#344D70",
    "panelTitle.inactiveForeground": "#60728B",
    "terminal.background": "#DFE7F1",
    "terminal.foreground": "#344D70",
    "terminalCursor.foreground": "#3F72A7",
    "terminal.selectionBackground": "#B4CDDE99",
    "terminal.ansiBlack": "#D1DDEA",
    "terminal.ansiRed": "#B73441",
    "terminal.ansiGreen": "#24784E",
    "terminal.ansiYellow": "#956216",
    "terminal.ansiBlue": "#225B8B",
    "terminal.ansiMagenta": "#75539E",
    "terminal.ansiCyan": "#3F72A7",
    "terminal.ansiWhite": "#344D70",
    "terminal.ansiBrightBlack": "#60728B",
    "terminal.ansiBrightRed": "#B73441",
    "terminal.ansiBrightGreen": "#24784E",
    "terminal.ansiBrightYellow": "#8C591F",
    "terminal.ansiBrightBlue": "#225B8B",
    "terminal.ansiBrightMagenta": "#75539E",
    "terminal.ansiBrightCyan": "#126E75",
    "terminal.ansiBrightWhite": "#344D70",
    "statusBar.background": "#D1DDEA",
    "statusBar.foreground": "#344D70",
    "statusBar.border": "#BAC8D9",
    "statusBarItem.remoteBackground": "#CFE5F1",
    "statusBarItem.remoteForeground": "#344D70",
    "notifications.background": "#DDE5EF",
    "notifications.foreground": "#344D70",
    "notifications.border": "#BAC8D9",
    "notificationCenterHeader.background": "#DFE7F1",
    "quickInput.background": "#DDE5EF",
    "quickInput.foreground": "#344D70",
    "peekView.border": "#3F72A7",
    "peekViewEditor.background": "#E8EDF5",
    "peekViewResult.background": "#DDE5EF",
    "gitDecoration.addedResourceForeground": "#24784E",
    "gitDecoration.modifiedResourceForeground": "#956216",
    "gitDecoration.deletedResourceForeground": "#B73441",
    "gitDecoration.untrackedResourceForeground": "#126E75",
    "diffEditor.insertedTextBackground": "#24784E26",
    "diffEditor.removedTextBackground": "#B7344126",
    "minimap.selectionHighlight": "#3F72A7",
    "scrollbarSlider.background": "#BAC8D988",
    "scrollbarSlider.hoverBackground": "#BAC8D9CC",
    "breadcrumb.foreground": "#60728B",
    "progressBar.background": "#3F72A7",
    "debugToolBar.background": "#DDE5EF",
    "debugIcon.breakpointForeground": "#B73441",
    "tree.indentGuidesStroke": "#BAC8D9",
    "settings.headerForeground": "#3F72A7",
    "editor.findMatchBackground": "#B4CDDE99",
    "editor.findMatchHighlightBackground": "#B4CDDE99"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C6A81",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#2F6296"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7C663A"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#8F5873"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#3A6E93"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#736284"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#344A68"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2E727B"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2E727B"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2F6296"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#5C6A7E"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2E727B"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#3A6E93",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#2E727B"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#24774E"
      }
    },
    {
      "name": "Deleted and invalid",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#B73441"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#2E727B",
    "type": "#736284",
    "class": "#736284",
    "enum": "#736284",
    "interface": "#736284",
    "struct": "#736284",
    "typeParameter": "#736284",
    "enumMember": "#8F5873",
    "function": "#3A6E93",
    "method": "#3A6E93",
    "parameter": "#2E727B",
    "property": "#344A68",
    "variable": "#344A68",
    "variable.readonly": "#8F5873",
    "variable.defaultLibrary": "#3A6E93",
    "keyword": "#2F6296",
    "string": "#7C663A",
    "number": "#8F5873",
    "regexp": "#2E727B",
    "comment": "#5C6A81",
    "operator": "#5C6A7E"
  }
}
